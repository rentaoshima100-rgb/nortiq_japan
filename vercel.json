  "rewrites": [
    {
      "source": "/(web|chatbot|dx|works|voice|support|pricing|quick-diagnosis|subsidy|guidebook|column|company|staff|sitemap|news|recruit|diagnostic|privacy|terms|privacy-handling)",
      "destination": "/app.html"
    },
    {
      "source": "/works-(clinic|realty|build|hr|retail|infra|ai)",
      "destination": "/app.html"
    },
    {
      "source": "/works-lp-(corp|recruit|ec)",
      "destination": "/app.html"
    },
    {
      "source": "/works-video",
      "destination": "/app.html"
    },
    {
      "source": "/solution-(clinic|realty|build|hr|retail)",
      "destination": "/app.html"
    },
    {
      "source": "/feature-(cms|lpo|recruit|analytics)",
      "destination": "/app.html"
    },
    {
      "source": "/product-(vetonet|wpchat|tennis)",
      "destination": "/app.html"
    }
  ],
  "regions": ["hnd1"],
  "functions": {
    "api/diagnose.js": {
      "maxDuration": 30
    },
    "api/contact.js": {
      "maxDuration": 15
    },
    "api/suggest.js": {
      "maxDuration": 10,
      "includeFiles": "api/_data/**"
    },
    "api/nq-event.js": {
      "maxDuration": 10,
      "includeFiles": "api/_data/**"
    },
    "api/nq-train.js": {
      "maxDuration": 60,
      "includeFiles": "api/_data/**"
    }
  },
  "crons": [
    {
      "path": "/api/nq-train",
      "schedule": "0 18 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app.bundle.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/articles.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/articles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
