{
  "name": "nortiq-website",
  "version": "1.0.0",
  "private": true,
  "description": "Nortiq Labs site — static production build",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.js",
    "prerender": "node build-prerender.js",
    "build:full": "node build.js && node build-prerender.js",
    "prerender:check": "node prerender-check.js",
    "render-pdf": "node render-pdf.mjs",
    "serve": "npx --yes serve dist -l 5173"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "marked": "^12.0.2",
    "playwright": "^1.40.0",
    "terser": "^5.30.0"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3",
    "pdfjs-dist": "^3.11.174"
  }
}
