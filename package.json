{
  "name": "nortiq-website",
  "version": "1.0.0",
  "private": true,
  "description": "Nortiq Labs site — static production build",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.js",
    "prerender": "node build-prerender.js",
    "build:full": "node build.js && node build-prerender.js",
    "prerender:check": "node prerender-check.js",
    "pricing:check": "node pricing-check.js",
    "tools:check": "node scripts/tools-check.js --dist",
    "tools:e2e": "node scripts/tools-e2e.js",
    "tools:verify": "node build.js && node scripts/tools-check.js --dist && node scripts/tools-e2e.js",
    "render-pdf": "node render-pdf.mjs",
    "serve": "npx --yes serve dist -l 5173",
    "test": "node --test \"api/_lib/*.test.js\"",
    "nq:eval": "node eval/run.js --provider jev",
    "nq:eval:check": "node eval/run.js --provider jev --baseline eval/baseline.json",
    "nq:tag-articles": "node eval/tag-articles.js"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "csso": "^5.0.5",
    "marked": "^12.0.2",
    "playwright": "^1.40.0",
    "terser": "^5.30.0"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3",
    "pdfjs-dist": "^3.11.174"
  }
}
